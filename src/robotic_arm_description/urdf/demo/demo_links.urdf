<?xml version="1.0"?>
<robot name="demo_links">
	<link name="base_link">
		<visual>
			<geometry>
				<cylinder length="1.0" radius="0.2"/>
			</geometry>
		</visual>
	</link>
	
	<link name="link_1">
		<visual>
			<geometry>
				<box size="0.5 0.1 0.2"/>
			</geometry>
			<origin xyz="0 0 0.2"/>
		</visual>
	</link>
	
	<joint name="base_link_to_link_1" type="fixed">
  		<parent link="base_link"/>
		<child link="link_1"/>
		<origin xyz="0 0.3 0.0"/>
	</joint>
</robot>

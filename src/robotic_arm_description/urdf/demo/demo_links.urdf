<?xml version="1.0"?>
<robot name="demo_links">
	<link name="base_link">
		<visual>
			<geometry>
				<cylinder length="0.5" radius="0.2"/>
			</geometry>
		</visual>
	</link>
	
	<link name="link_1">
		<visual>
			<geometry>
				<box size="0.5 0.1 0.2"/>
			</geometry>
			<origin rpy="0 0 1" xyz="0 0 0.5"/>
		</visual>
	</link>
	
	<joint name="base_link_to_link_1" type="revolute">
		<axis xyz="0 0 1"/>
		<limit effort="1000.0" lower="-10.0" upper="10.0" velocity="0.5"/>
  		<parent link="base_link"/>
		<child link="link_1"/>
		<origin xyz="0 0.0 0.0"/>
	</joint>
</robot>

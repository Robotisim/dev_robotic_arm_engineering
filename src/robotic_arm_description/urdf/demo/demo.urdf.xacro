<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="demo">
	<xacro:property name="length" value="1.0"/>
	<xacro:property name="diameter" value="0.8"/>
	<link name="base_link">
		<visual>
			<geometry>
				<cylinder length="${length}" radius="${diameter/2}"/>
			</geometry>
		</visual>
	</link>
</robot>

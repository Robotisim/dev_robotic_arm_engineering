<?xml version="1.0"?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="name" default="panda"/>
  <xacro:arg name="prefix" default="panda_"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="gripper" default="true"/>

  <xacro:property name="name" value="$(arg name)"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="gripper_enabled" value="$(arg gripper)"/>
  <xacro:property name="mesh_dir" value="$(find robot_arm_bringup)/meshes/panda"/>

  <xacro:include filename="$(find robot_arm_bringup)/urdf/common_materials.xacro"/>

  <link name="${prefix}link0">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link0.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link0.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.025566 -2.87883e-05 0.057332"/>
      <mass value="2.814271300104062"/>
      <inertia ixx="0.007539" ixy="-1.505e-05" ixz="-0.001214" iyy="0.010508" iyz="1.043e-05" izz="0.009865"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link0">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint1" type="revolute">
    <parent link="${prefix}link0"/>
    <child link="${prefix}link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.333"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.897246558310587" upper="2.897246558310587" velocity="2.6179938779914944"/>
    <dynamics damping="21.75" friction="3.48"/>
  </joint>
  <gazebo reference="${prefix}joint1">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-3.72212e-09 -0.0324958 -0.0675818"/>
      <mass value="2.6433170427227215"/>
      <inertia ixx="0.017405" ixy="-8.688e-09" ixz="-1.628e-08" iyy="0.015352" iyz="0.004511" izz="0.005988"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link1">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint2" type="revolute">
    <parent link="${prefix}link1"/>
    <child link="${prefix}link2"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-1.7627825445142729" upper="1.7627825445142729" velocity="2.6179938779914944"/>
    <dynamics damping="21.75" friction="3.48"/>
  </joint>
  <gazebo reference="${prefix}joint2">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="3.17833e-07 -0.06861 0.0322285"/>
      <mass value="2.6652755331661186"/>
      <inertia ixx="0.017787" ixy="8.706e-08" ixz="3.752e-08" iyy="0.006044" iyz="-0.004599" izz="0.015711"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link2">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint3" type="revolute">
    <parent link="${prefix}link2"/>
    <child link="${prefix}link3"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 -0.316 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.897246558310587" upper="2.897246558310587" velocity="2.6179938779914944"/>
    <dynamics damping="21.75" friction="3.48"/>
  </joint>
  <gazebo reference="${prefix}joint3">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0469893 0.0316374 -0.031704"/>
      <mass value="2.3293714829045733"/>
      <inertia ixx="0.007550" ixy="-0.002432" ixz="-0.003251" iyy="0.009681" iyz="-0.002132" izz="0.007945"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link3">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint4" type="revolute">
    <parent link="${prefix}link3"/>
    <child link="${prefix}link4"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0.0825 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-3.07177948351002" upper="-0.06981317007977318" velocity="2.6179938779914944"/>
    <dynamics damping="21.75" friction="3.48"/>
  </joint>
  <gazebo reference="${prefix}joint4">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link4.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link4.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0360505 0.0337069 0.0319019"/>
      <mass value="2.3104763646281508"/>
      <inertia ixx="0.007765" ixy="0.003371" ixz="-0.002344" iyy="0.008016" iyz="0.002292" izz="0.009956"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link4">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint5" type="revolute">
    <parent link="${prefix}link4"/>
    <child link="${prefix}link5"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="-0.0825 0.384 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" lower="-2.897246558310587" upper="2.897246558310587" velocity="3.141592653589793"/>
    <dynamics damping="3.0" friction="0.48"/>
  </joint>
  <gazebo reference="${prefix}joint5">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link5.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link5.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-6.12525e-06 0.0610427 -0.104176"/>
      <mass value="2.6226426154892004"/>
      <inertia ixx="0.029071" ixy="6.209e-07" ixz="-1.006e-05" iyy="0.027639" iyz="-0.007424" izz="0.004251"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link5">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint6" type="revolute">
    <parent link="${prefix}link5"/>
    <child link="${prefix}link6"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" lower="-0.017453292519943295" upper="3.752457891787808" velocity="3.141592653589793"/>
    <dynamics damping="3.0" friction="0.48"/>
  </joint>
  <gazebo reference="${prefix}joint6">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link6">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link6.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link6.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.051051 0.00910797 0.0106343"/>
      <mass value="1.5025804886626795"/>
      <inertia ixx="0.002941" ixy="-0.000424" ixz="0.000610" iyy="0.003921" iyz="0.000126" izz="0.005412"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link6">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <joint name="${prefix}joint7" type="revolute">
    <parent link="${prefix}link6"/>
    <child link="${prefix}link7"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0.088 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" lower="-2.897246558310587" upper="2.897246558310587" velocity="3.141592653589793"/>
    <dynamics damping="3.0" friction="0.48"/>
  </joint>
  <gazebo reference="${prefix}joint7">
    <springStiffness value="0.0"/>
    <springReference value="0.0"/>
  </gazebo>

  <link name="${prefix}link7">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/visual/link7.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/collision/link7.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0109695 0.0107965 0.0650412"/>
      <mass value="0.5237668134788256"/>
      <inertia ixx="0.000862" ixy="-0.000119" ixz="3.867e-05" iyy="0.000861" iyz="-9.058e-05" izz="0.000696"/>
    </inertial>
  </link>
  <gazebo reference="${prefix}link7">
    <mu1 value="0.85"/>
    <mu2 value="0.85"/>
  </gazebo>

  <link name="${prefix}link8"/>

  <joint name="${prefix}joint8_virtual" type="fixed">
    <parent link="${prefix}link7"/>
    <child link="${prefix}link8"/>
    <origin rpy="0 0 -0.7853981633974483" xyz="0 0 0.107"/>
  </joint>

  <link name="${prefix}tool0">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <material name="orange_accent"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
  </link>

  <joint name="${prefix}tool_joint" type="fixed">
    <parent link="${prefix}link8"/>
    <child link="${prefix}tool0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <xacro:if value="${gripper_enabled}">
    <joint name="${prefix}wrist_joint" type="fixed">
      <parent link="${prefix}link8"/>
      <child link="${prefix}hand"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${prefix}hand">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/visual/hand.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/collision/hand.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="-6.7624e-06 0.00152435 0.0275912"/>
        <mass value="0.14060765127978503"/>
        <inertia ixx="0.000537" ixy="1.791e-08" ixz="-2.320e-08" iyy="7.705e-05" iyz="4.681e-08" izz="0.000494"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}hand">
      <mu1 value="0.85"/>
      <mu2 value="0.85"/>
    </gazebo>

    <joint name="${prefix}finger_joint1" type="prismatic">
      <parent link="${prefix}hand"/>
      <child link="${prefix}leftfinger"/>
      <origin rpy="0 0 0" xyz="0 0 0.0584"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" lower="0" upper="0.04" velocity="0.2"/>
      <dynamics damping="3.0" friction="0.4"/>
    </joint>
    <gazebo reference="${prefix}finger_joint1">
      <springStiffness value="0.0"/>
      <springReference value="0.0"/>
    </gazebo>

    <link name="${prefix}leftfinger">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/visual/finger.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/collision/finger.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 0" xyz="-6.2561e-06 0.00227781 -0.0277116"/>
        <mass value="0.2238453537819424"/>
        <inertia ixx="6.748e-05" ixy="-4.103e-09" ixz="1.869e-08" iyy="6.627e-05" iyz="1.197e-05" izz="1.550e-05"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}leftfinger">
      <mu1 value="1.13"/>
      <mu2 value="1.13"/>
    </gazebo>

    <joint name="${prefix}finger_joint2" type="prismatic">
      <parent link="${prefix}hand"/>
      <child link="${prefix}rightfinger"/>
      <origin rpy="0 0 0" xyz="0 0 0.0584"/>
      <axis xyz="0 -1 0"/>
      <limit effort="20" lower="0" upper="0.04" velocity="0.2"/>
      <mimic joint="${prefix}finger_joint1"/>
      <dynamics damping="3.0" friction="0.4"/>
    </joint>
    <gazebo reference="${prefix}finger_joint2">
      <springStiffness value="0.0"/>
      <springReference value="0.0"/>
    </gazebo>

    <link name="${prefix}rightfinger">
      <visual>
        <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/visual/finger.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/collision/finger.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin rpy="0 0 3.141592653589793" xyz="-6.2561e-06 0.00227781 -0.0277116"/>
        <mass value="0.2238453537819424"/>
        <inertia ixx="6.748e-05" ixy="-4.103e-09" ixz="1.869e-08" iyy="6.627e-05" iyz="1.197e-05" izz="1.550e-05"/>
      </inertial>
    </link>
    <gazebo reference="${prefix}rightfinger">
      <mu1 value="1.13"/>
      <mu2 value="1.13"/>
    </gazebo>
  </xacro:if>

  <xacro:include filename="$(find robot_arm_bringup)/urdf/panda_arm.ros2_control.xacro"/>
  <xacro:panda_ros2_control name="${name}" prefix="${prefix}" controllers_file="$(arg controllers_file)"/>
</robot>

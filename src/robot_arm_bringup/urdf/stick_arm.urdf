<?xml version="1.0"?>
<robot name="stick_arm_4dof">

  <!-- Materials -->
  <material name="steel_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="orange_accent">
    <color rgba="1.0 0.35 0.0 1.0"/>
  </material>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.18 0.18 0.12"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.18 0.18 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.012" ixy="0.0" ixz="0.0"
               iyy="0.012" iyz="0.0"
               izz="0.012"/>
    </inertial>
  </link>

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.03"/>
      </geometry>
      <material name="orange_accent"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.35" radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.013" ixy="0.0" ixz="0.0"
               iyy="0.013" iyz="0.0"
               izz="0.0006"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="30.0" velocity="2.0"/>
    <dynamics damping="0.15" friction="0.05"/>
  </joint>

  <!-- Link 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.30" radius="0.028"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>

    <collision>
      <origin xyz="0.15 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.30" radius="0.028"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0"
               iyy="0.0068" iyz="0.0"
               izz="0.0068"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="25.0" velocity="2.0"/>
    <dynamics damping="0.12" friction="0.03"/>
  </joint>

  <!-- Link 3 -->
  <link name="link3">
    <visual>
      <origin xyz="0.125 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.024"/>
      </geometry>
      <material name="orange_accent"/>
    </visual>

    <collision>
      <origin xyz="0.125 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.25" radius="0.024"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <mass value="0.7"/>
      <inertia ixx="0.00025" ixy="0.0" ixz="0.0"
               iyy="0.0037" iyz="0.0"
               izz="0.0037"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="20.0" velocity="2.2"/>
    <dynamics damping="0.10" friction="0.03"/>
  </joint>

  <!-- Link 4 -->
  <link name="link4">
    <visual>
      <origin xyz="0.09 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.02"/>
      </geometry>
      <material name="steel_gray"/>
    </visual>

    <collision>
      <origin xyz="0.09 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder length="0.18" radius="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.09 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00012" ixy="0.0" ixz="0.0"
               iyy="0.0014" iyz="0.0"
               izz="0.0014"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="15.0" velocity="2.5"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <!-- Tool -->
  <link name="tool0">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="orange_accent"/>
    </visual>

    <collision>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0.0" ixz="0.0"
               iyy="0.00003" iyz="0.0"
               izz="0.00003"/>
    </inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
    <parent link="link4"/>
    <child link="tool0"/>
  </joint>

</robot>